# ARGUS environment configuration — PLACEHOLDERS ONLY, no real secrets.
# Copy to `.env` for local development (`.env` is git-ignored). See M0 spec §5.
# Real environment variables override values set here.

# local | test | staging | production
ARGUS_ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive)
ARGUS_LOG_LEVEL=INFO

# Service name stamped onto logs/diagnostics.
ARGUS_SERVICE_NAME=argus

# Build metadata. Injected at container build; "unknown" in local dev.
ARGUS_GIT_SHA=unknown
